# Porta do servidor (http://localhost:3000).
PORT=3000

# [MONGODB] Endereço de conexão. Local: mongodb://localhost:27017. Atlas: mongodb+srv://USUARIO:SENHA@cluster.mongodb.net/
MONGO_URI=mongodb://localhost:27017
# [MONGODB] Nome do banco de dados (a coleção "produtos" é criada dentro dele).
MONGO_DB=catalogo

# [REDIS] Endereço de conexão. Local: redis://localhost:6379. Redis Cloud: redis://default:SENHA@HOST:PORTA
REDIS_URL=redis://localhost:6379

# [SUPABASE] URL do projeto (botão Connect no painel do Supabase).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# [SUPABASE] Chave PÚBLICA (publishable key "sb_publishable_..." ou a antiga anon key). Usada no login e na leitura dos planos.
SUPABASE_ANON_KEY=cole-aqui-a-anon-public-key

# E-mails autorizados como administrador (separados por vírgula). Deve ser o mesmo e-mail criado no Supabase Auth.
ADMIN_EMAILS=admin@seudominio.com

# Número que recebe os pedidos: DDI + DDD + número, só dígitos.
WHATSAPP_NUMBER=558699999999
